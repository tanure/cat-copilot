{
  "name": "@catpilot/desktop",
  "version": "0.9.0",
  "private": true,
  "description": "CatPilot workspace desktop",
  "author": "CatPilot contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanure/cat-copilot.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win:signed": "electron-builder --config electron-builder.windows-signed.cjs --win --x64 --publish never && pwsh -NoProfile -NonInteractive -File scripts/verify-windows-signatures.ps1"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lucide/svelte": "1.73.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tiptap/core": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/extension-task-list": "3.34.0",
    "@tiptap/extension-task-item": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/view": "^6.38.6",
    "codemirror": "^6.0.2",
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "electron": "42.11.18",
    "electron-builder": "26.18.0",
    "electron-vite": "^5.0.0",
    "svelte": "5.57.3",
    "svelte-check": "^4.4.5",
    "vite": "7.3.8"
  }
}
